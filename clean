#!/usr/bin/env node
/*
Usage:
  node docs/cleanaapp [--dry-run] [--yes|-y] [--git] [--force|-f]

Options:
  --dry-run   (default) list files that start with '._' but do not delete
  --yes, -y   actually delete the files found
  --git       when deleting, also run `git rm --cached` on files that are tracked
  --force, -f force deletion even when the AppleDouble maps to an ignored target

This script avoids scanning node_modules, .git, .next, and public by default.
*/

const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const args = process.argv.slice(2);
const dryRun = args.indexOf('--dry-run') !== -1 || (args.indexOf('--yes') === -1 && args.indexOf('-y') === -1);
const doDelete = args.indexOf('--yes') !== -1 || args.indexOf('-y') !== -1;
const doGit = args.indexOf('--git') !== -1;
const forceDelete = args.indexOf('--force') !== -1 || args.indexOf('-f') !== -1;

const repoRoot = process.cwd();
const IGNORE_DIRS = new Set([]);
// const IGNORE_DIRS = new Set(['.git', 'node_modules', '.next', 'public']);

// ignore AppleDouble files that correspond to important/large targets
const IGNORED_TARGETS = new Set([
  // 'node_modules',
  // '.next',
  // '.git',
  // '.gitignore',
  // 'package.json',
  // 'package-lock.json',
]);

function isAppleDoubleName(name) {
  return name.startsWith('._');
}

async function walk(dir, cb) {
  const entries = await fs.promises.readdir(dir, { withFileTypes: true });
  for (const ent of entries) {
    const name = ent.name;
    if (IGNORE_DIRS.has(name)) continue;
    const full = path.join(dir, name);
    if (ent.isDirectory()) {
      await walk(full, cb);
    } else if (ent.isFile()) {
      await cb(full);
    }
  }
}

(async function main(){
  try {
    const found = [];
    const skipped = [];
    await walk(repoRoot, async (filePath) => {
      const base = path.basename(filePath);
      if (isAppleDoubleName(base)) {
        const target = base.slice(2); // remove leading '._'
        if (IGNORED_TARGETS.has(target)) {
          if (!forceDelete) {
            skipped.push(filePath);
            return;
          }
          // if forceDelete is true we still include the file but log it specially
          found.push(filePath);
          return;
        }
        found.push(filePath);
      }
    });

    if (found.length === 0) {
      console.log('No removable files starting with \'._\' were found.');
      if (skipped.length > 0) {
        console.log(`Skipped ${skipped.length} AppleDouble file(s) that map to ignored targets (e.g. node_modules):`);
        skipped.forEach(f => console.log('  ' + f));
      }
      process.exit(0);
    }

    console.log(`Found ${found.length} removable file(s) starting with '._':`);
    found.forEach(f => console.log('  ' + f));
    if (skipped.length > 0) {
      console.log(`\nIgnored ${skipped.length} AppleDouble file(s) that map to ignored targets (e.g. node_modules):`);
      skipped.forEach(f => console.log('  ' + f));
    }

    if (dryRun) {
      console.log('\nDry run: no files were removed. Rerun with --yes to delete.');
      if (forceDelete) console.log('Note: --force was specified (no-op in dry-run).');
      process.exit(0);
    }

    // deletion
    let deleted = 0;
    for (const f of found) {
      try {
        await fs.promises.unlink(f);
        deleted++;
        if (doGit) {
          // remove from git index if tracked
          const r = spawnSync('git', ['rm', '--cached', '--ignore-unmatch', f], { cwd: repoRoot, stdio: 'inherit' });
          if (r.error) {
            console.error('git rm failed for', f, r.error);
          }
        }
      } catch (e) {
        console.error('Failed to delete', f, e.message || e);
      }
    }

    console.log(`\nDeleted ${deleted} file(s).`);
    if (doGit && deleted > 0) {
      console.log('\nRun `git status` to review changes and commit if desired.');
    }
  } catch (err) {
    console.error('Error during scan:', err);
    process.exit(1);
  }
    // when --all is provided, include node_modules and .next in the scan (but still keep .git ignored)
})();
